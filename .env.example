# Copy to `.env` (gitignored) and fill in. Every script reads it automatically.
#
# Without MAYA_API_KEY there is no voice-over, and with no voice-over there is
# nothing for the beat lengths to be measured against — the video falls back to
# reading-speed guesses and nothing is in sync with anything. `gen-voice.mjs`
# refuses to run rather than degrade quietly; pass --allow-silent if you
# genuinely want a silent render.
#
# Get a key at https://mayaresearch.ai
MAYA_API_KEY=

# Optional. A specific Chrome/Edge binary for recon, capture and the recorder.
# Leave empty to auto-detect.
PITCHFRAME_BROWSER=

# Optional. Where run folders are archived. Defaults to `runs/` at the tool root.
PITCHFRAME_RUNS=
