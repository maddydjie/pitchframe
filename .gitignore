node_modules/

# Render artefacts. Nothing a render produces belongs in the repo — the
# pipeline regenerates all of it, and video files bloat clones permanently
# because git keeps every version of a binary forever.
out/
output*.mp4
template/output*.mp4
template/out/

# Per-run working files: logs, drafts, capture manifests, captured screenshots.
# These are outputs of a run against someone's product, not part of the tool.
.work/

# Secrets. MAYA_API_KEY lives here so it survives between shells instead of
# being re-exported (or forgotten, which is what made every video silent).
# It is a live credential and this repo is meant to be published.
.env

# Archived runs — each holds a script, plan, direction, feedback and an MP4 for
# one video made against someone's product. They are outputs, and the videos
# would bloat the repo permanently. `runs/` is still load-bearing at runtime:
# art-direction.mjs reads the directions in here to avoid repeating a look.
runs/
template/public/assets/*.png
!template/public/assets/.gitkeep

# Screen recordings. A few hundred JPEG frames plus the cursor track — tens of
# megabytes per hero moment, regenerated by capture.mjs on every run.
template/public/assets/*/
template/public/assets/*.track.json

# Generated audio. Synthesized from plan.json by gen-audio.mjs in about a
# second, so there is nothing to gain by committing 8MB of WAV.
template/public/audio/*.wav
template/public/audio/audio.json

# Music tracks ARE committed, on the owner's confirmation that the licence
# permits redistribution. This is the one asset class where that has to be an
# explicit decision rather than a default: a plugin hands every byte it
# contains to everyone who installs it, and most stock-music licences forbid
# exactly that. If the licence ever changes, re-ignore this folder first.
#
# Voice-over is different — it is regenerated per script from the user's own
# Maya key, so it is output, not an asset.
template/public/audio/vo/

# theme.ts is generated from palette.json by scripts/apply-palette.mjs.
# It is committed so the repo renders on a fresh clone without running the
# palette pipeline first — regenerate it, don't hand-edit it.

.DS_Store
Thumbs.db
*.log

# Reference material. Frame extracts from other companies' launch videos, used
# to derive the motion language in skills/pitchframe-motion-language. The
# techniques are not ownable; the footage is theirs. What ships is the written
# analysis, never the frames.
frameybyframe/
*.zip
